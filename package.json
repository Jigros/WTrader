{
  "name": "donutsmp-trading-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "controller": "tsx apps/controller/src/main.ts",
    "backtest": "tsx apps/backtester/src/main.ts",
    "replay": "tsx apps/backtester/src/replay.ts",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "benchmark:hot-path": "tsx apps/benchmark/src/hot-path.ts",
    "simulate:e2e": "vitest run tests/e2e-trading.test.ts",
    "bridge:observe": "tsx apps/minecraft-executor/src/observe-only-main.ts",
    "replay:session": "tsx apps/minecraft-executor/src/replay-session.ts"
  },
  "dependencies": {
    "ioredis": "^5.7.0",
    "minecraft-data": "^3.113.2",
    "mineflayer": "^4.37.1",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "prismarine-chat": "^1.13.0",
    "ws": "^8.21.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
